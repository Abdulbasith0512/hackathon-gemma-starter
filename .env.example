# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Gemma 4 IDs served by the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
# If left unset or as a placeholder, the app falls back to gemma-4-26b-a4b-it.
GEMMA_MODEL=gemma-4-26b-a4b-it

# How much Gemma "thinks" before answering. Less thinking is much faster (about 4s
# instead of 15s per request in testing). If unset, "minimal" is used.
# Values: minimal | low | medium | high | default (default = send no setting, the
# model's own behaviour, slowest). gemma-4-26b-a4b-it accepts minimal and high;
# if a model rejects the level you choose, the app logs a warning and continues
# with the model's default thinking.
GEMMA_THINKING=minimal
